generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  MEMBER
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum WorkflowStepType {
  MANUAL
  HTTP_REQUEST
  AI_CLASSIFICATION
  CONDITION
  CREATE_TASK
  NOTIFICATION
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum ExecutionStepStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum IntegrationType {
  HTTP
  NOTIFICATION
  AI
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  users        User[]
  workflows    Workflow[]
  executions   Execution[]
  tasks        Task[]
  integrations Integration[]
  auditLogs    AuditLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model User {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String         @unique
  passwordHash   String
  role           UserRole       @default(MEMBER)
  refreshTokens  RefreshToken[]
  workflows      Workflow[]     @relation("WorkflowCreatedBy")
  executions     Execution[]    @relation("ExecutionCreatedBy")
  assignedTasks  Task[]         @relation("TaskAssignee")
  auditLogs      AuditLog[]     @relation("AuditActor")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Workflow {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         WorkflowStatus @default(DRAFT)
  version        Int            @default(1)
  createdBy      String
  creator        User           @relation("WorkflowCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  steps          WorkflowStep[]
  executions     Execution[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([organizationId, updatedAt])
}

model WorkflowStep {
  id             String           @id @default(cuid())
  workflowId     String
  workflow       Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name           String
  type           WorkflowStepType
  configuration  Json
  position       Int
  nextStepId     String?
  executionSteps ExecutionStep[]
  tasks          Task[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([workflowId, position])
  @@index([workflowId])
  @@index([nextStepId])
}

model Execution {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId      String
  workflow        Workflow        @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  workflowVersion Int
  workflowSnapshot Json
  status          ExecutionStatus @default(PENDING)
  input           Json
  output          Json?
  error           Json?
  idempotencyKey  String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdBy       String
  creator         User            @relation("ExecutionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  steps           ExecutionStep[]
  tasks           Task[]
  createdAt       DateTime        @default(now())

  @@unique([organizationId, workflowId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, workflowId, createdAt])
  @@index([idempotencyKey])
}

model ExecutionStep {
  id             String              @id @default(cuid())
  executionId    String
  execution      Execution           @relation(fields: [executionId], references: [id], onDelete: Cascade)
  workflowStepId String
  workflowStep   WorkflowStep        @relation(fields: [workflowStepId], references: [id], onDelete: Restrict)
  status         ExecutionStepStatus @default(PENDING)
  input          Json
  output         Json?
  error          Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  attempt        Int                 @default(1)
  createdAt      DateTime            @default(now())

  @@index([executionId])
  @@index([workflowStepId])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executionId    String
  execution      Execution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  workflowStepId String
  workflowStep   WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Restrict)
  title          String
  description    String?
  status         TaskStatus   @default(OPEN)
  assignedTo     String?
  assignee       User?        @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  completedAt    DateTime?

  @@index([organizationId, status, createdAt])
  @@index([executionId])
  @@index([assignedTo])
}

model Integration {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           IntegrationType
  configuration  Json
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, type])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([entityType, entityId])
}
