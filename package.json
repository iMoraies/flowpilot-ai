{
  "name": "flowpilot-ai",
  "version": "0.1.0",
  "description": "FlowPilot AI is a modular monolith for business process automation with queues, integrations, AI-ready architecture, and observability.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/jobs/workflow-worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/jobs/workflow-worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:lint": "npm --prefix apps/web run lint",
    "web:test": "npm --prefix apps/web run test",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@prisma/client": "6.12.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.58.7",
    "fastify": "^5.6.0",
    "ioredis": "^5.7.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "prisma": "6.12.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^5.0.1"
  }
}
