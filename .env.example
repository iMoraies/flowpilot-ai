NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
ENABLE_SWAGGER=true

DATABASE_URL=postgresql://flowpilot:flowpilot_dev_password@localhost:5432/flowpilot_ai?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-long-random-secret-for-local-development
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW=1 minute
ENABLE_METRICS=true
AI_PROVIDER=mock
